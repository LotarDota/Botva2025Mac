<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Botva2025.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="650"
        x:Class="Botva2025.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Botva2025 — macOS"
        Width="850" Height="650"
        MinWidth="700" MinHeight="500">

  <Window.Styles>
    <Style Selector="CheckBox">
      <Setter Property="Margin" Value="2"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,4,0,2"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Top: Login Panel -->
    <Border Grid.Row="0" Background="#F0F0F0" Padding="8" CornerRadius="4" Margin="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Логин:" VerticalAlignment="Center"/>
        <TextBox Text="{Binding UserName}" Width="120" Watermark="Имя"/>
        <TextBlock Text="Пароль:" VerticalAlignment="Center"/>
        <TextBox Text="{Binding UserPass}" Width="120" PasswordChar="*" Watermark="Пароль"/>
        <TextBlock Text="Сервер:" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding ServerOptions}" SelectedIndex="{Binding UserServer}" Width="140"/>
        <Button Content="Войти" Command="{Binding LoginCommand}" Width="60"/>
        <Button Content="Старт/Стоп"
                Command="{Binding StartBotCommand}" Width="80" FontWeight="Bold"/>
        <Button Content="Браузер" Command="{Binding OpenBrowserCommand}" Width="65"/>
      </StackPanel>
    </Border>

    <!-- Middle: Settings + Log -->
    <Grid Grid.Row="1" ColumnDefinitions="*,300" Margin="4">
      <!-- Left: Checkbox panels in ScrollViewer -->
      <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="4" Margin="4">

          <!-- Основной сервер -->
          <Expander Header="Основной сервер" IsExpanded="True">
            <WrapPanel>
              <CheckBox Content="Авто запуск" IsChecked="{Binding CheckBoxGo}"/>
              <CheckBox Content="Авто вход" IsChecked="{Binding CheckBoxLoad}"/>
              <CheckBox Content="Бодалка" IsChecked="{Binding CheckBoxBodalka}"/>
              <CheckBox Content="Бодалка Штаб" IsChecked="{Binding CheckBoxBodalkaShtab}"/>
              <CheckBox Content="Зорро" IsChecked="{Binding CheckBoxBodalkaZorro}"/>
              <CheckBox Content="Страшилки" IsChecked="{Binding CheckBoxBodalkaStrashilki}"/>
              <CheckBox Content="Работа" IsChecked="{Binding CheckBoxRabota}"/>
              <CheckBox Content="Класс Историй" IsChecked="{Binding CheckBoxKlassIstorii}"/>
              <CheckBox Content="Кораблик" IsChecked="{Binding CheckBoxKorablik}"/>
              <CheckBox Content="Умений" IsChecked="{Binding CheckBoxYmeniy}"/>
              <CheckBox Content="Арена" IsChecked="{Binding CheckBoxArena}"/>
              <CheckBox Content="Сражалка" IsChecked="{Binding CheckBoxSrajalka}"/>
              <CheckBox Content="Дозор" IsChecked="{Binding CheckBoxDozor}"/>
              <CheckBox Content="Музей" IsChecked="{Binding CheckBoxMuzey}"/>
              <CheckBox Content="Икарус" IsChecked="{Binding CheckBoxIkarus}"/>
              <CheckBox Content="Ферма" IsChecked="{Binding CheckBoxFerma}"/>
              <CheckBox Content="Кри Макс" IsChecked="{Binding CheckBoxKriMax}"/>
              <CheckBox Content="Макс Босс" IsChecked="{Binding CheckBoxMaxBoss}"/>
              <CheckBox Content="Воспиталка" IsChecked="{Binding CheckBoxVospitalka}"/>
              <CheckBox Content="Заговор" IsChecked="{Binding CheckBoxZagovor}"/>
            </WrapPanel>
          </Expander>

          <!-- Качалка -->
          <Expander Header="Качалка / Помогашки">
            <WrapPanel>
              <CheckBox Content="Качалка" IsChecked="{Binding CheckBoxKach}"/>
              <CheckBox Content="Кач 1" IsChecked="{Binding CheckBoxKach1}"/>
              <CheckBox Content="Кач 2" IsChecked="{Binding CheckBoxKach2}"/>
              <CheckBox Content="Кач 3" IsChecked="{Binding CheckBoxKach3}"/>
              <CheckBox Content="Кач 4" IsChecked="{Binding CheckBoxKach4}"/>
              <CheckBox Content="Кач 5" IsChecked="{Binding CheckBoxKach5}"/>
              <CheckBox Content="Кач Макс" IsChecked="{Binding CheckBoxKachMax}"/>
              <CheckBox Content="Кач Пирашки" IsChecked="{Binding CheckBoxKachPirashki}"/>
              <CheckBox Content="Кач Пирашки Пост" IsChecked="{Binding CheckBoxKachPirashkiPost}"/>
            </WrapPanel>
          </Expander>

          <!-- Работа -->
          <Expander Header="Работа">
            <WrapPanel>
              <CheckBox Content="Учёба" IsChecked="{Binding CheckBoxRabotaYcheba}"/>
              <CheckBox Content="Очистка" IsChecked="{Binding CheckBoxRabotaOchistka}"/>
              <CheckBox Content="Плавка" IsChecked="{Binding CheckBoxRabotaPlavka}"/>
              <CheckBox Content="Карьера" IsChecked="{Binding CheckBoxKarera}"/>
            </WrapPanel>
          </Expander>

          <!-- Крепость -->
          <Expander Header="Крепость">
            <WrapPanel>
              <CheckBox Content="Жаловатся" IsChecked="{Binding CheckBoxKrepostJalovatsy}"/>
              <CheckBox Content="Таверна" IsChecked="{Binding CheckBoxKrepostTaverna}"/>
              <CheckBox Content="Дуб" IsChecked="{Binding CheckBoxKrepostDub}"/>
              <CheckBox Content="Подземные Тонели" IsChecked="{Binding CheckBoxKrepostPodzemnyeToneli}"/>
              <CheckBox Content="Акад.Прикл. Замок" IsChecked="{Binding CheckBoxKrepostAkademiyPrikluchencevZamok}"/>
              <CheckBox Content="Акад.Прикл. Храм" IsChecked="{Binding CheckBoxKrepostAkademiyPrikluchencevHram}"/>
              <CheckBox Content="Шижина Клад" IsChecked="{Binding CheckBoxKrepostShijinaTuristaKlad}"/>
              <CheckBox Content="Шижина Разведка" IsChecked="{Binding CheckBoxKrepostShijinaTuristaRazvedka}"/>
            </WrapPanel>
          </Expander>

          <!-- Таверна -->
          <Expander Header="Таверна">
            <WrapPanel>
              <CheckBox Content="Ярмарка" IsChecked="{Binding CheckBoxTavernaYarmarka}"/>
              <CheckBox Content="Ботолс" IsChecked="{Binding CheckBoxTavernaBotols}"/>
              <CheckBox Content="Война" IsChecked="{Binding CheckBoxTavernaVoyna}"/>
              <CheckBox Content="Лучше/Хуже" IsChecked="{Binding CheckBoxTavernaLuchsheHyje}"/>
            </WrapPanel>
          </Expander>

          <!-- Аватар -->
          <Expander Header="Аватар">
            <WrapPanel>
              <CheckBox Content="Шахта" IsChecked="{Binding CheckBoxAvatarShaxta}"/>
              <CheckBox Content="Бодалка" IsChecked="{Binding CheckBoxAvatarBodalka}"/>
              <CheckBox Content="Штаб Белый Список" IsChecked="{Binding CheckBoxAvatarShtabBeliySpisok}"/>
              <CheckBox Content="Кораблик" IsChecked="{Binding CheckBoxAvatarKorablik}"/>
              <CheckBox Content="Земли Сбор" IsChecked="{Binding CheckBoxAvatarZemliSbor}"/>
              <CheckBox Content="Музей" IsChecked="{Binding CheckBoxAvatarMyzey}"/>
              <CheckBox Content="Икарус" IsChecked="{Binding CheckBoxAvatarIkarus}"/>
              <CheckBox Content="Поляна" IsChecked="{Binding CheckBoxAvatarPolyna}"/>
              <CheckBox Content="Страшилки" IsChecked="{Binding CheckBoxAvatarStrashilki}"/>
              <CheckBox Content="Качалка" IsChecked="{Binding CheckBoxAvatarKach}"/>
              <CheckBox Content="Кач Пирашка" IsChecked="{Binding CheckBoxAvatarKachPirashka}"/>
              <CheckBox Content="Битва Шашта" IsChecked="{Binding CheckBoxAvatarBitvaShashta}"/>
              <CheckBox Content="Тайный Орден" IsChecked="{Binding CheckBoxAvatarTaynyyOrden}"/>
              <CheckBox Content="Тайный Орден Спуск" IsChecked="{Binding CheckBoxAvatarTaynyyOrdenSpusk}"/>
              <CheckBox Content="Тайный Орден Свитки" IsChecked="{Binding CheckBoxAvatarTaynyyOrdenSvitki}"/>
              <CheckBox Content="Ферма" IsChecked="{Binding CheckBoxFermaAvatar}"/>
            </WrapPanel>
          </Expander>

          <!-- Торговля -->
          <Expander Header="Торговля / Ресурсы">
            <WrapPanel>
              <CheckBox Content="Рабы Продать" IsChecked="{Binding CheckBoxRabyProdat}"/>
              <CheckBox Content="Пыль Продать" IsChecked="{Binding CheckBoxPylProdat}"/>
              <CheckBox Content="Пыль Купить" IsChecked="{Binding CheckBoxPylKypit}"/>
              <CheckBox Content="Покупаем Мыло" IsChecked="{Binding CheckBoxPokypaemMylo}"/>
              <CheckBox Content="Покупаем Ртуть" IsChecked="{Binding CheckBoxPokypaemRtut}"/>
              <CheckBox Content="Покупаем Удрен" IsChecked="{Binding CheckBoxPokypaemYdren}"/>
            </WrapPanel>
          </Expander>

          <!-- Панда -->
          <Expander Header="Панда / Сундуки">
            <WrapPanel>
              <CheckBox Content="Панда Продать" IsChecked="{Binding CheckBoxPandaProdat}"/>
              <CheckBox Content="Панда Использовать Все" IsChecked="{Binding CheckBoxPandaIspolzovatVse}"/>
              <CheckBox Content="Панда Открыть" IsChecked="{Binding CheckBoxPandaOtkryt}"/>
              <CheckBox Content="Сундук Открыть" IsChecked="{Binding CheckBoxSyndykOpen}"/>
              <CheckBox Content="Радужный Сундук" IsChecked="{Binding CheckBoxRadyjniySundyk}"/>
            </WrapPanel>
          </Expander>

          <!-- Другое -->
          <Expander Header="Другое">
            <WrapPanel>
              <CheckBox Content="Арена Список" IsChecked="{Binding CheckBoxArenaList}"/>
              <CheckBox Content="Арена Штаб" IsChecked="{Binding CheckBoxArenaShtab}"/>
              <CheckBox Content="Храм Парящих Истин" IsChecked="{Binding CheckBoxHramParyshihIstin}"/>
              <CheckBox Content="Замок" IsChecked="{Binding CheckBoxZamok}"/>
              <CheckBox Content="Подземные Залы" IsChecked="{Binding CheckBoxPodzemkyeZaly}"/>
              <CheckBox Content="Катакомбы" IsChecked="{Binding CheckBoxKatokomb}"/>
              <CheckBox Content="Кат. Очки" IsChecked="{Binding CheckBoxKatokombOchki}"/>
              <CheckBox Content="Кат. Пыль" IsChecked="{Binding CheckBoxKatokombPyl}"/>
              <CheckBox Content="Кат. Сыр" IsChecked="{Binding CheckBoxKatokombSyr}"/>
              <CheckBox Content="Кат. Пирашки" IsChecked="{Binding CheckBoxKatokombPirashi}"/>
              <CheckBox Content="Летающая Корова" IsChecked="{Binding CheckBoxLetaushayKorova}"/>
              <CheckBox Content="Перезапуск WebDriver" IsChecked="{Binding CheckBoxReloadWebDriver}"/>
            </WrapPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <!-- Right: Log panel -->
      <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="4" Margin="4,0,0,0" Padding="4">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Лог" Foreground="White" FontWeight="Bold" Margin="4"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding ConsoleLog}"
                   Background="Transparent" Foreground="#00FF00"
                   FontFamily="Courier New" FontSize="10"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom: Status bar -->
    <Border Grid.Row="2" Background="#F0F0F0" Padding="8" Margin="4,0,4,4" CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="Bold"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0">
          <TextBlock Text="{Binding LabelName}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Золото:" VerticalAlignment="Center" Foreground="Goldenrod"/>
          <TextBlock Text="{Binding LabelZoloto}" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="8,0">
          <TextBlock Text="Кри:" VerticalAlignment="Center" Foreground="DeepSkyBlue"/>
          <TextBlock Text="{Binding LabelKri}" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Пир:" VerticalAlignment="Center" Foreground="OrangeRed"/>
          <TextBlock Text="{Binding LabelPir}" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="8,0">
          <TextBlock Text="Зелень:" VerticalAlignment="Center" Foreground="Green"/>
          <TextBlock Text="{Binding LabelZelen}" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
